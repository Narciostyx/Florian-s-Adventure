<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C0DE0006-0006-4F00-9A00-000000000006}</ProjectGuid>
    <RootNamespace>fa_input</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(SolutionDir)build\Project.props" />
  </ImportGroup>
  <!-- Binding persistence uses nlohmann/json, which pulls in the MSVC STL's
       <chrono>; that header contains an inline function with a real try/catch
       block (get_tzdb_list) that cannot be parsed with unwind semantics off, so
       the global /EHsc- fails here with C4530. Only this project and fa_events
       turn /EHsc back on, and no fa_input code throws or catches.
       See docs/build/m07-input.md. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Action.cpp" />
    <ClCompile Include="src\ActionMap.cpp" />
    <ClCompile Include="src\Binding.cpp" />
    <ClCompile Include="src\InputContext.cpp" />
    <ClCompile Include="src\InputDevice.cpp" />
    <ClCompile Include="src\InputSystem.cpp" />
    <ClInclude Include="..\include\fa\input\Action.hpp" />
    <ClInclude Include="..\include\fa\input\ActionMap.hpp" />
    <ClInclude Include="..\include\fa\input\Binding.hpp" />
    <ClInclude Include="..\include\fa\input\Input.hpp" />
    <ClInclude Include="..\include\fa\input\InputContext.hpp" />
    <ClInclude Include="..\include\fa\input\InputDevice.hpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\engine\core\fa_core.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\platform\fa_platform.vcxproj" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
