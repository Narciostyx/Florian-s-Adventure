<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C0DE0017-0017-4F00-9A00-000000000017}</ProjectGuid>
    <RootNamespace>fa_ai</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(SolutionDir)build\Project.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- World/PhysicsWorld headers use std::unordered_map; this library opts
           into /EHsc rather than spreading the setting to every dependent. -->
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\AiService.cpp" />
    <ClInclude Include="..\include\fa\ai\AiService.hpp" />
    <ClInclude Include="..\include\fa\ai\AiTypes.hpp" />
  </ItemGroup>
  <!-- M21 reads transforms/health, queries the map and physics, and spawns
       attacks through the M20 interface. It does not include M16's controller. -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\engine\core\fa_core.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\scene\fa_scene.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\physics\fa_physics.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\tilemap\fa_tilemap.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\combat\fa_combat.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\player\fa_player.vcxproj" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
