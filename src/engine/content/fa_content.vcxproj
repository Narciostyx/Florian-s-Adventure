<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C0DE000D-000D-4F00-9A00-00000000000D}</ProjectGuid>
    <RootNamespace>fa_content</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(SolutionDir)build\Project.props" />
  </ImportGroup>
  <ItemGroup>
    <ClCompile Include="src\ContentDatabase.cpp" />
    <ClCompile Include="src\ContentId.cpp" />
    <ClCompile Include="src\ContentTypes.cpp" />
    <ClInclude Include="..\include\fa\content\ContentDatabase.hpp" />
    <ClInclude Include="..\include\fa\content\ContentError.hpp" />
    <ClInclude Include="..\include\fa\content\ContentId.hpp" />
    <ClInclude Include="..\include\fa\content\ContentTypes.hpp" />
  </ItemGroup>
  <!-- ContentDatabase.cpp parses with nlohmann/json, whose headers contain
       try/catch internals that do not compile with unwind semantics off (C4530).
       Only this project turns /EHsc back on; no fa_content code throws or catches.
       See docs/build/m15-content-database.md. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- fa_core for Result/ContentId hashing; fa_assets for AssetId-only references.
       No M11: content definitions store ids and values, never entity pointers. -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\engine\core\fa_core.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\assets\fa_assets.vcxproj" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
