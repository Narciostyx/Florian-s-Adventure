<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C0DE000C-000C-4F00-9A00-00000000000C}</ProjectGuid>
    <RootNamespace>fa_player</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(SolutionDir)build\Project.props" />
  </ImportGroup>
  <ItemGroup>
    <ClCompile Include="src\PlayerController.cpp" />
    <ClCompile Include="src\PlayerSystem.cpp" />
    <ClCompile Include="src\PlayerTypes.cpp" />
    <ClInclude Include="..\include\fa\player\PlayerController.hpp" />
    <ClInclude Include="..\include\fa\player\PlayerError.hpp" />
    <ClInclude Include="..\include\fa\player\PlayerSystem.hpp" />
    <ClInclude Include="..\include\fa\player\PlayerTypes.hpp" />
  </ItemGroup>
  <!-- PlayerSystem.cpp includes fa/input/Input.hpp, which pulls <unordered_map>
       through ActionMap; those headers contain try/catch internals and need /EHsc.
       No fa_player code throws or catches. PlayerController itself only uses core,
       scene and physics. See docs/build/m16-player-controller.md. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- fa_input for IInput, fa_scene for World/Transform, fa_physics for Velocity.
       M16 deliberately does not link fa_tilemap or fa_interaction: it records
       PlayerActionRequest values and the composition root routes them. -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\engine\core\fa_core.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\time\fa_time.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\input\fa_input.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\scene\fa_scene.vcxproj" />
    <ProjectReference Include="$(SolutionDir)src\engine\physics\fa_physics.vcxproj" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
