<?xml version="1.0" encoding="utf-8"?>
<!--
  Florian's Adventure - shared MSBuild settings.
  Source of truth: docs/architecture/tech-stack.md sections 3-5.

  Every .vcxproj inherits these properties. Do NOT override compiler flags per
  project unless a comment explains why.

  Requirements:
    - VCPKG_ROOT environment variable must point at the vcpkg checkout, or the
      vcpkg MSBuild integration must be installed (`vcpkg integrate install`).
  PlatformToolset is intentionally NOT set: it defaults to the toolset that
  ships with the installed Visual Studio, so VS2026 works without pinning.
-->
<Project>
  <PropertyGroup Label="Globals">
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Pick the toolset that ships with the installed Visual Studio. Without
         this, MSBuild falls back to v100 and fails with MSB8020. Override with
         /p:PlatformToolset=... or /p:FA_PlatformToolset=... if needed. -->
    <PlatformToolset Condition="'$(FA_PlatformToolset)' != ''">$(FA_PlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == '' and '$(VisualStudioVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals($(VisualStudioVersion), 18.0))">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
  </PropertyGroup>

  <PropertyGroup Label="ProjectLevel">
    <CharacterSet>Unicode</CharacterSet>
    <MultiProcessorCompilation>true</MultiProcessorCompilation>
  </PropertyGroup>

  <!-- Compiler-front-end settings. These are ClCompile item metadata: putting
       them in a plain PropertyGroup silently does nothing. -->
  <ItemDefinitionGroup Label="LanguageAndDiagnostics">
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SupportJustMyCode>false</SupportJustMyCode>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup Label="Layout">
    <OutDir>$(SolutionDir)build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>$(MSBuildProjectName)</TargetName>
  </PropertyGroup>

  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <VcpkgTriplet>x64-windows-static-md</VcpkgTriplet>
    <VcpkgHostTriplet>x64-windows</VcpkgHostTriplet>
  </PropertyGroup>

  <!-- Debug: /MDd, no optimization, debug tools on. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>FA_DEBUG;FA_ENABLE_EDITOR;FA_ENABLE_DEBUG_TOOLS;FA_ENABLE_PROFILING;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Development: optimized + symbols, no LTCG. Day-to-day build. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Development'">
    <UseDebugLibraries>false</UseDebugLibraries>
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Development'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>FA_DEVELOPMENT;FA_ENABLE_EDITOR;FA_ENABLE_DEBUG_TOOLS;FA_ENABLE_PROFILING;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Release: shipping build. Editor and debug tools can still be forced on
       by passing /p:FA_ForceTools=true at build time. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>FA_RELEASE;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(FA_ForceTools)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>FA_ENABLE_EDITOR;FA_ENABLE_DEBUG_TOOLS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableSpecificWarnings>4100;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release-only link settings. -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
</Project>
